// For format details, see https://containers.dev/implementors/json_reference/
// Image source: https://github.com/devcontainers/images/tree/main/src/rust
{
	"name": "Rust",
	"image": "mcr.microsoft.com/devcontainers/rust:1-trixie",

	// Needed for debugging with LLDB
	"capAdd": ["SYS_PTRACE"],
	"securityOpt": ["seccomp=unconfined"],

	// Install the toolchain pinned in rust-toolchain.toml and the `just` command runner
	"postCreateCommand": "rustup toolchain install && sudo apt-get update && sudo apt-get install -y --no-install-recommends just",

	"customizations": {
		"vscode": {
			"settings": {
				// Don't watch build output
				"files.watcherExclude": {
					"**/target/**": true
				},
				"rust-analyzer.check.command": "clippy"
			},
			"extensions": [
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb",
				"tamasfe.even-better-toml",
				"fill-labs.dependi"
			]
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	"remoteUser": "vscode"
}
