[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.99"
{%- if description %}
description = "{{ description }}"
{%- endif %}
license = "MIT"

[dependencies]

# Lint levels for rustc, clippy and rustdoc. CI runs clippy with -D warnings, so "warn" fails CI.
[lints.clippy]
# priority = -1 lets individual clippy lints listed here override the group
pedantic = { level = "warn", priority = -1 }

[lints.rust]
missing_docs = "warn"
unsafe_code = "forbid"
