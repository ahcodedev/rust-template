# Local macOS dev setup. Install with: brew bundle
# After installing, run `rustup default stable` once to download the toolchain.

# Rust toolchain manager (provides rustc, cargo, clippy, rustfmt)
brew "rustup"

# Command runner for project scripts (see justfile)
brew "just"

# Project template tool; run `copier update` to pull in template changes
brew "copier"

# GitHub Actions linters (run by `just lint`)
brew "actionlint"
brew "zizmor"

# Git hook manager (see prek.toml); `just setup` installs the hooks
brew "prek"

# Secret scanner (prek hook and `just gitleaks`)
brew "gitleaks"

# Dev tools
# brew "bacon"          # background checker: re-runs clippy/tests on save
# brew "cargo-nextest"  # faster test runner
